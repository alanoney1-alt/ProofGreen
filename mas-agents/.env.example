# ProofGreen MAS Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Core AI Services
# =============================================================================

# Anthropic API (Required for AI agents)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AGENT_MODEL=claude-sonnet-4-20250514

# =============================================================================
# External API Keys
# =============================================================================

# Rewiring America API (Incentive calculations)
REWIRING_AMERICA_API_KEY=your_rewiring_america_api_key_here

# Tavily Search API (Regulatory monitoring)
TAVILY_API_KEY=your_tavily_api_key_here

# Firecrawl API (Web scraping for regulations)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# WattTime API (Grid carbon intensity)
WATTTIME_USERNAME=your_watttime_username
WATTTIME_PASSWORD=your_watttime_password

# =============================================================================
# Vector Database (Semantic Search)
# =============================================================================

# Pinecone (Regulatory knowledge base)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=esg-regulations
PINECONE_ENVIRONMENT=us-east-1-aws

# =============================================================================
# FSM (Field Service Management) Integrations
# =============================================================================

# ServiceTitan
SERVICETITAN_API_KEY=your_servicetitan_api_key
SERVICETITAN_TENANT_ID=your_tenant_id
SERVICETITAN_CLIENT_ID=your_client_id
SERVICETITAN_CLIENT_SECRET=your_client_secret

# Jobber
JOBBER_API_KEY=your_jobber_api_key
JOBBER_CLIENT_ID=your_client_id
JOBBER_CLIENT_SECRET=your_client_secret

# Housecall Pro
HOUSECALL_PRO_API_KEY=your_housecall_pro_api_key

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL (Audit trail, governance tasks)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proofgreen

# Redis (Caching, session storage)
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Application Settings
# =============================================================================

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
DEBUG=false

# Application
APP_NAME=ProofGreen MAS
APP_VERSION=1.0.0
ENVIRONMENT=development

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "https://proofgreen.io"]

# =============================================================================
# Security
# =============================================================================

# JWT for API authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Webhook secrets (for signature verification)
SERVICETITAN_WEBHOOK_SECRET=your_webhook_secret
JOBBER_WEBHOOK_SECRET=your_webhook_secret

# =============================================================================
# MCP Server Configuration
# =============================================================================

# MCP Server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001

# Legal Scout monitoring schedule
LEGAL_SCOUT_SCHEDULE=weekly
LEGAL_SCOUT_VERTICALS=hvac,plumbing,electrical

# =============================================================================
# Governance & HITL
# =============================================================================

# Approval thresholds by risk level (in dollars)
APPROVAL_THRESHOLD_LOW=1000
APPROVAL_THRESHOLD_MEDIUM=500
APPROVAL_THRESHOLD_HIGH=100
APPROVAL_THRESHOLD_CRITICAL=0

# Task expiry (hours)
TASK_EXPIRY_HOURS=72

# =============================================================================
# Compliance & Reporting
# =============================================================================

# Reporting year
REPORTING_YEAR=2026

# Default state for compliance checks
DEFAULT_STATE=CA

# SB 253 threshold (revenue in millions)
SB253_REVENUE_THRESHOLD=1000

# =============================================================================
# Logging
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Sentry (Error tracking)
SENTRY_DSN=your_sentry_dsn_here

# =============================================================================
# Feature Flags
# =============================================================================

# Enable/disable features
ENABLE_VISION_OCR=true
ENABLE_FIRECRAWL_SCRAPING=true
ENABLE_PINECONE_SEARCH=true
ENABLE_HITL_APPROVALS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_VOICE_TRIAGE=true
ENABLE_PREDICTIVE_OUTREACH=true
ENABLE_LESSONS_LEARNED=true

# =============================================================================
# Docker Configuration
# =============================================================================

# PostgreSQL Container
POSTGRES_USER=proofgreen
POSTGRES_PASSWORD=proofgreen_secret
POSTGRES_DB=proofgreen

# =============================================================================
# Communication Services (Voice Triage)
# =============================================================================

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# Vapi (Voice AI)
VAPI_API_KEY=your_vapi_api_key

# =============================================================================
# Weather API (Predictive Outreach)
# =============================================================================

OPENWEATHER_API_KEY=your_openweather_api_key

# =============================================================================
# Security & Encryption
# =============================================================================

# AES-256 encryption key for credentials vault (32 bytes)
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# =============================================================================
# Monitoring & Observability
# =============================================================================

PROMETHEUS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=proofgreen-mas
GRAFANA_ADMIN_PASSWORD=admin
